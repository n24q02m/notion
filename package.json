{
  "name": "@n24q02m/notion",
  "mcpName": "io.github.n24q02m/notion",
  "keywords": [
    "notion",
    "api",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agent",
    "composite-tools",
    "claude",
    "cursor",
    "copilot",
    "antigravity",
    "codex",
    "opencode"
  ],
  "version": "2.44.0-beta.2",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -build && node scripts/build-cli.js",
    "dev": "tsx watch scripts/start-server.ts",
    "dev:http": "TRANSPORT_MODE=http tsx watch scripts/start-server.ts",
    "test": "vitest --passWithNoTests",
    "test:watch": "vitest watch",
    "test:full": "vitest run tests/live/*.full.test.ts",
    "test:coverage": "vitest --coverage",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "tsc --noEmit",
    "check": "biome check . && bun run type-check",
    "check:fix": "biome check --write . && bun run type-check",
    "prepublishOnly": "bun run build",
    "docker:build": "docker build -t n24q02m/notion:latest .",
    "docker:push": "docker push n24q02m/notion:latest",
    "docker:run": "docker run --rm -i -e NOTION_TOKEN n24q02m/notion:latest"
  },
  "bin": {
    "notion": "bin/cli.mjs",
    "better-notion-mcp": "bin/cli.mjs"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "files": [
    "build/",
    "bin/",
    "npm-shrinkwrap.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@n24q02m/hull": "^0.7.0",
    "@notionhq/client": "^5.31.0",
    "zod": "^4.6.7"
  },
  "trustedDependencies": [
    "esbuild"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "description": "Markdown-first Notion for AI agents -- pages, databases, blocks, and comments in one call.",
  "main": "build/src/init-server.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/n24q02m/notion.git"
  },
  "author": "n24q02m",
  "bugs": {
    "url": "https://github.com/n24q02m/notion/issues"
  },
  "homepage": "https://github.com/n24q02m/notion#readme"
}
